{
  "name": "france-housses",
  "version": "0.1.0",
  "private": true,
  "description": "FRANCE HOUSSES — boutique de housses de siège, tapis et bâches sur mesure (code repris de LEDVROOM)",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev -p 3400",
    "build": "prisma generate && next build",
    "start": "next start -p ${PORT:-3400}",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "seed:demo": "tsx prisma/seed.ts --demo",
    "test": "vitest run",
    "test:watch": "vitest",
    "admin:create": "tsx scripts/create-admin.ts",
    "jobs:run": "tsx --conditions=react-server scripts/run-jobs.ts",
    "test:db:setup": "createdb fh_test || true && DATABASE_URL=\"postgresql://$USER@localhost:5432/fh_test?schema=public\" prisma migrate deploy",
    "contenus:accueil": "tsx scripts/sync-home-blocks.ts",
    "visibles": "tsx scripts/compte-visibles.ts",
    "import:france-housses": "tsx scripts/import-france-housses.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@prisma/client": "^6.19.3",
    "next": "^16.3.1",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "stripe": "^23.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  }
}
